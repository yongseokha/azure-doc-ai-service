# --- App ---
APP_NAME=Document AI Service
DEBUG=true

# --- Azure Document Intelligence ---
# Azure Portal > Document Intelligence 리소스 > 키 및 엔드포인트
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource-name>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_API_KEY=<your-api-key>

# --- Azure File Storage (OCR 원본/결과 저장) ---
AZURE_FILE_STORAGE_CONNECTION_STRING=<예: DefaultEndpointsProtocol=https;AccountName=계정명;AccountKey=키값;EndpointSuffix=core.windows.net>
AZURE_FILE_SHARE_NAME=ocr-archive

# --- File Upload ---
MAX_UPLOAD_SIZE_MB=20
